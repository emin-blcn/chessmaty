[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]

linux.x86_64.debug =     "res://lib/chessmaty_rust_linux_x86_64_debug.so"
linux.x86_64.release =   "res://lib/chessmaty_rust_linux_x86_64_release.so"

windows.x86_64.debug =   "res://lib/chessmaty_rust_windows_x86_64_debug.dll"
windows.x86_64.release = "res://lib/chessmaty_rust_windows_x86_64_release.dll"