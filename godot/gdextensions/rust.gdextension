[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]

linux.debug.x86_64 =     "res://lib/librust_linux_x86_64_debug.so"
linux.release.x86_64 =   "res://lib/librust_linux_x86_64_release.so"

windows.debug.x86_64 =   "res://lib/librust_windows_x86_64_debug.dll"
windows.release.x86_64 = "res://lib/librust_windows_x86_64_release.dll"

windows.debug.arm64 =    "res://lib/librust_windows_arm64_debug.dll"
windows.release.arm64 =  "res://lib/librust_windows_arm64_release.dll"